# Copy to .env.local for local development. The values below match a local Supabase stack
# started with `supabase start` from the repository root; `supabase status` prints the key.

# Supabase project URL and publishable key (sb_publishable_...). The publishable key is safe in a
# browser: every table is behind row level security. Never put the secret key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:14321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The address this app is served from. Google sign-in returns to {SITE_URL}/{lang}/auth/callback,
# which must match an entry in Supabase Auth's redirect allow list.
SITE_URL=http://localhost:3000

# Error tracking (T031): Sentry's masirah-web project, EU region. The DSN is not a secret; the
# browser sends its errors with it. Leave it empty to send nothing, as in local runs and tests.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Build time only, and a secret: uploads source maps for readable stack traces. Set on Netlify.
SENTRY_AUTH_TOKEN=
