# One line ending everywhere, so Prettier and ruff agree on every machine
* text=auto eol=lf

*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary

# Claude Design exports: bundled pages with fonts and scripts inlined. Kept as the design
# reference, never diffed or reviewed line by line.
Docs/design/Figma[[:space:]]export/*.html binary linguist-generated
