# Copy to .env (gitignored) and fill in. The worker and the accuracy gate read these.
# Load them for a local run with: uv run --env-file .env <command>

# Model provider keys. Server-side only: never in any variable the browser can read.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider and model serve each tier (AI-05), written provider:model. Comparing providers
# is a change here (decision Q5). Every model must be priced in adapters/provider_registry.py.
MASIRAH_CHEAP_MODEL=anthropic:claude-haiku-4-5
MASIRAH_STRONG_MODEL=anthropic:claude-sonnet-5

# Egyptian pounds per US dollar, for cost per CV in EGP (NFR-13). Keep it near the current rate.
MASIRAH_EGP_PER_USD=50

# The worker process (python -m masirah_pipeline). Postgres as the masirah_worker role, whose login
# an operator grants where the worker runs; never the service role. Locally:
#   alter role masirah_worker with login password '...';  (in the local database only)
MASIRAH_DATABASE_URL=
# The name this worker's heartbeat is recorded under for /api/health; defaults to the host's name.
MASIRAH_WORKER_NAME=
# Storage, for reading original CV files and nothing else.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# OCR for scans and photographs (T078). "tesseract" reads them with Tesseract, which must be
# installed with Arabic data (ara.traineddata, ideally from tessdata_best). Leave empty to send
# them to the review queue unread. The command and data directory default to Tesseract's own.
MASIRAH_OCR=
MASIRAH_TESSERACT_CMD=
MASIRAH_TESSDATA_DIR=

# Error tracking and alerts (T031, NFR-14). Errors go to Sentry, EU region, when the DSN is set;
# the DSN is not a secret. The parse failure alert posts to Slack through an incoming webhook,
# whose URL is a secret: anyone holding it can post to the channel. Without it, alerts are only
# logged, which Sentry still picks up.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
MASIRAH_SLACK_WEBHOOK_URL=

# Daily backups of the hosted project (T110, NFR-15): python -m tools.backup run, scheduled by
# tools/schedule_backup.ps1. Docs/runbooks/backup-recovery.md has the setup and the restore.
# The hosted database through the session pooler (Supabase dashboard > Connect), with the
# database password. A secret.
MASIRAH_BACKUP_DB_URL=
# The hosted project's URL and secret key (sb_secret_...), for reading the CV originals. A secret.
MASIRAH_BACKUP_SUPABASE_URL=
MASIRAH_BACKUP_SUPABASE_SECRET_KEY=
# The age public key from `python -m tools.backup keygen`. Not a secret; the private key is, and
# lives offline, never on this machine.
MASIRAH_BACKUP_RECIPIENT=
# Where the encrypted backups go. A synced folder (Google Drive, OneDrive) keeps a copy off this PC.
MASIRAH_BACKUP_DIR=
