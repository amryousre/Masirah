# Copy to .env (gitignored) and fill in. The worker and the accuracy gate read these.
# Load them for a local run with: uv run --env-file .env <command>

# Model provider keys. Server-side only: never in any variable the browser can read.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Which provider and model serve each tier (AI-05), written provider:model. Comparing providers
# is a change here (decision Q5). Every model must be priced in adapters/provider_registry.py.
MASIRAH_CHEAP_MODEL=anthropic:claude-haiku-4-5
MASIRAH_STRONG_MODEL=anthropic:claude-sonnet-5

# Egyptian pounds per US dollar, for cost per CV in EGP (NFR-13). Keep it near the current rate.
MASIRAH_EGP_PER_USD=50

# The worker process (python -m masirah_pipeline). Postgres as the masirah_worker role, whose login
# an operator grants where the worker runs; never the service role. Locally:
#   alter role masirah_worker with login password '...';  (in the local database only)
MASIRAH_DATABASE_URL=
# Storage, for reading original CV files and nothing else.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
